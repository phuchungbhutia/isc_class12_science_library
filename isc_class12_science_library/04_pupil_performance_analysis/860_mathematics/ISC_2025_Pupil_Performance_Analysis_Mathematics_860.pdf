				<div class="elementor-element elementor-element-f897776 elementor-hidden-desktop elementor-hidden-tablet elementor-hidden-mobile elementor-widget elementor-widget-shortcode" data-id="f897776" data-element_type="widget" data-widget_type="shortcode.default">
				<div class="elementor-widget-container">
							<div class="elementor-shortcode">    <style>
        .faq-floating-button {
            border: 2px solid #fff;
            position: fixed;
            bottom: 20px;
            right: 20px;
            /* background: #007bff; */
            background: #203b92;
            color: white;
            width: 60px;
            height: 60px;
            border-radius: 50%;
            font-size: 28px;
            text-align: center !important;
            line-height: 60px;
            cursor: pointer;
            z-index: 10000;
        }

        .faq-popup {
            display: none;
            position: fixed;
            bottom: 100px;
            right: 20px;
            width: 340px;
            height: 500px;
            background: #fff;
            border: 1px solid #ccc;
            border-radius: 12px;
            z-index: 9999;
            box-shadow: 0 8px 16px rgba(0, 0, 0, 0.2);
            overflow: hidden;
            display: flex;
            flex-direction: column;
            font-size: 13px;
            font-family: 'Segoe UI', sans-serif;
        }

        .faq-popup-header {
            /* background: #007bff; */
            background: #203b92 !important;
            color: white;
            padding: 10px;
            font-weight: bold;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .faq-chat-log {
            flex: 1;
            padding: 10px;
            overflow-y: auto;
            background: #f9f9f9;
        }

        .faq-message {
            margin: 5px 0;
            clear: both;
        }

        .faq-user {
            float: right;
            background: #cce5ff;
            padding: 6px 10px;
            border-radius: 12px;
            max-width: 80%;
        }

        .faq-bot {
            float: left;
            background: #e9ecef;
            padding: 6px 10px;
            border-radius: 12px;
            max-width: 80%;
        }

        .faq-input-area {
            padding: 8px 10px;
            border-top: 1px solid #ccc;
            background: #fff;
            display: flex;
            gap: 6px;
        }

        .faq-input-area input {
            flex: 1;
            padding: 6px;
            font-size: 13px;
            border-radius: 6px;
            border: 1px solid #ccc;
        }

        .faq-input-area button {
            padding: 6px 10px;
            font-size: 13px;
            /* background: #007bff; */
            background: #203b92 !important;
            color: white;
            border: none;
            border-radius: 6px;
            cursor: pointer;
        }

        .faq-suggestions {
            padding: 8px 10px;
            display: flex;
            flex-wrap: wrap;
            gap: 6px;
            background: #fff;
            border-top: 1px solid #ccc;
        }

        .faq-suggestions button {
            text-align: left;
            padding: 5px 10px;
            /* border: 1px solid #007bff; */
            border: 1px solid #203b92;
            background: #fff;
            /* color: #007bff; */
            color: #203b92;
            border-radius: 16px;
            cursor: pointer;
            font-size: 13px;
        }
    </style>

    <div class="faq-floating-button" onclick="toggleFaqChat()" title="Click here for the CISCE AI Agent">
        💬
        <!-- <img draggable="false" role="img" class="emoji" alt="💬" src="//s.w.org/images/core/emoji/15.1.0/svg/1f4ac.svg"> -->
    </div>


    <div class="faq-popup" id="faq-popup" style="display: none;">
        <!-- <div class="faq-popup-header">
            <img src="//cisce.org/wp-content/uploads/2022/09/logo-cisce.webp" alt="Chat Assistant" style="height: 24px; border-radius: 50%;" />
            <span style="text-align: left !important;">Chat Assistant</span>
            <span style="cursor:pointer;" onclick="toggleFaqChat()">✖</span>
        </div> -->
        <div class="faq-popup-header">
            <div style="display: flex; align-items: center; gap: 0px;">
                <img decoding="async" src="//cisce.org/wp-content/uploads/2022/09/logo-cisce.webp" alt="Chat Assistant" style="height: 50px; border-radius: 50%;">
                <span style="text-align: left; font-size:1.05rem;">Chat Assistant</span>
            </div>
            <span style="cursor:pointer;" onclick="toggleFaqChat()">✖</span>
        </div>

        <div class="faq-chat-log" id="faq-log">
            <div class="faq-message faq-bot">Hi! What can I help you with?</div>
        </div>
        <div class="faq-suggestions" id="faq-suggestions"></div>
        <div class="faq-input-area" id="faq-input-box">
            <input type="text" id="faq-input" placeholder="Type your message..." />
            <button onclick="faqSend()">➤</button>
        </div>
    </div>

    <script data-cfasync="false" src="/cdn-cgi/scripts/5c5dd728/cloudflare-static/email-decode.min.js"></script><script>
        let selectedQuestions = [];

        function toggleFaqChat() {
            const popup = document.getElementById("faq-popup");
            popup.style.display = popup.style.display === "none" || popup.style.display === "" ? "flex" : "none";
        }

        function faqAsk(text) {
            document.getElementById('faq-input').value = text;
            // lastSelected = text.toLowerCase(); // Store clicked question
            if (!selectedQuestions.includes(text.toLowerCase())) {
                selectedQuestions.push(text.toLowerCase());
            }
            faqSend();
        }

        function faqSend() {
            const inputBox = document.getElementById('faq-input');
            const input = inputBox.value.trim();
            if (!input) return;

            const log = document.getElementById('faq-log');
            log.innerHTML += `<div class='faq-message faq-user'>${input}</div>`;
            inputBox.value = '';

            // fetch('https://cisce.org/wp-admin/admin-ajax.php?action=faq_chatbot_ask&q=' + encodeURIComponent(input))
            //     .then(res => res.json())
            //     .then(data => {
            //         log.innerHTML += `<div class='faq-message faq-bot'>${data.answer}</div>`;
            //         log.scrollTop = log.scrollHeight;

            //         const suggestions = document.getElementById('faq-suggestions');
            //         suggestions.innerHTML = ''; // Clear previous ones
            //         if (data.related && data.related.length > 0) {
            //             data.related.forEach(q => {
            //                 const btn = document.createElement('button');
            //                 btn.textContent = q;
            //                 btn.onclick = () => faqAsk(q);
            //                 suggestions.appendChild(btn);
            //             });
            //             suggestions.style.display = 'flex';
            //         } else {
            //             suggestions.style.display = 'none';
            //         }
            //     });

            fetch('https://cisce.org/wp-admin/admin-ajax.php?action=faq_chatbot_ask', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({
                        q: input,
                        selected: selectedQuestions
                    })
                })
                .then(res => res.json())
                .then(data => {
                    log.innerHTML += `<div class='faq-message faq-bot'>${data.answer}</div>`;
                    log.scrollTop = log.scrollHeight;

                    const suggestions = document.getElementById('faq-suggestions');
                    suggestions.innerHTML = '';

                    if (data.related && data.related.length > 0) {
                        data.related.forEach(q => {
                            const btn = document.createElement('button');
                            btn.textContent = q;
                            btn.onclick = () => faqAsk(q);
                            suggestions.appendChild(btn);
                        });
                        suggestions.style.display = 'flex';
                    } else {
                        suggestions.style.display = 'none';
                    }
                });

        }

        document.addEventListener("DOMContentLoaded", function() {
            document.getElementById("faq-input").addEventListener("keydown", function(e) {
                if (e.key === "Enter") {
                    e.preventDefault();
                    faqSend();
                }
            });

            // Load initial suggestions
            fetch(`https://cisce.org/wp-admin/admin-ajax.php?action=faq_chatbot_suggestions`)
                .then(res => res.json())
                .then(data => {
                    const suggestionsHTML = data.map(q => `<button onclick=\"faqAsk('${q}')\">${q}</button>`).join('');
                    document.getElementById('faq-suggestions').innerHTML = suggestionsHTML;
                });
        });
    </script>
</div>
						</div>
				</div>
					</div>
		</div>
					</div>
		</section>
				<section class="elementor-section elementor-top-section elementor-element elementor-element-7ea3e05 elementor-section-full_width elementor-section-height-default elementor-section-height-default" data-id="7ea3e05" data-element_type="section" data-settings="{&quot;background_background&quot;:&quot;classic&quot;}">
