.elementor-posts-container:hover {
    animation-play-state: paused !important;
}

/* Pause even when hovering on a single post */
.elementor-posts-container .elementor-post:hover {
    animation-play-state: paused !important;
}

.elementor-20560 .elementor-element.elementor-element-3f9712c .elementor-posts-container article {
    margin-bottom: 0px !important;
    align-self: center;
    
}
@keyframes scroll-left {
  0% {
    transform: translateX(0);
  }
  100% {
    transform: translateX(-20%);
  }
}

.elementor-posts--skin-full_content {
    animation: scroll-left 10s linear infinite !important;
    display: flex;
    width: max-content;
}
.elementor-20560 .elementor-element.elementor-element-3f9712c .elementor-posts-container article {
        margin-bottom: 0px !important;
    align-self: center;
    max-width: max-content;
    display: contents;
}

.elementor-posts-container.elementor-posts.elementor-posts--skin-full_content.elementor-grid {
  display: flex;
  align-items: center;
}

.elementor-posts-container article {
  display: flex;
  align-items: center;
}

.elementor-posts-container article:not(:last-child)::after {
  content: "•"; /* bullet character */
  margin: 0px 12px; /* space around bullet */
  font-size: 18px;
  color: #fcde4d; /* change bullet color */

}

.elementor-posts-container:hover {
  animation-play-state: paused;
}

.hidden {   
    overflow: hidden;
}/* End custom CSS */
/* Start custom CSS for ekit-nav-menu, class: .elementor-element-2e7de41 */@media (max-width: 1024px) {
.elementor-20560 .elementor-element.elementor-element-2e7de41 .elementskit-menu-container {
    max-width: none;
    margin-top: 30px !important;
}
}

.elementor-20560 .elementor-element.elementor-element-2e7de41 .elementskit-menu-container {
    height: 100% !important;
}/* End custom CSS */
/* Start custom CSS for section, class: .elementor-element-eb0c867 *//* Top bar */
.top-bar {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  z-index: 9999;
}

/* Navigation bar */
.nav-bar {
  position: fixed;
  top: 33px; /* Adjust to match top bar height */
  left: 0;
  width: 100%;
  z-index: 9998; /* Slightly less so top bar stays above if overlapping */
}

/* Push page content down so it doesn't hide under header */
.site-content {
  padding-top: 68px; /* top bar height + nav height */
}/* End custom CSS */
/* Start custom CSS for column, class: .elementor-element-9355d4f */.column-height {
    height: 1px !important;
    background: transparent;
}
.column-height > img {
    top: -80px !important;
}/* End custom CSS */
/* Start custom CSS for section, class: .elementor-element-1862a0b *//* Top bar */
