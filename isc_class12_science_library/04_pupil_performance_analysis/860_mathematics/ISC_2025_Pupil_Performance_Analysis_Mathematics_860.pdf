		<style id="wp-custom-css">
			body, 
h1, h2, h3, h4, h5, h6, 
p, a, span, div, li, ul, ol, 
blockquote, input, textarea, button, label, table, th, td {
   font-family: "Inter", sans-serif !important;
}
#wpadminbar .ab-icon, #wpadminbar .ab-item:before, #wpadminbar>#wp-toolbar>#wp-admin-bar-root-default .ab-icon, .wp-admin-bar-arrow {
	font: normal 20px/1 dashicons !important;
}

.foogallery.fg-thumbnail .fg-image {
    max-width: 100%;
    height: revert-layer;
}
body {
	background-color: #eff6ff !important;
}


.ast-single-post .entry-content a, .ast-comment-content a:not(.ast-comment-edit-reply-wrap a){
	
    text-decoration: none!important;
	
}
.foogallery .fg-caption-title {
    font-family: 'Poppins';
}

header.entry-header .entry-title{
	display:none;
}


.ast-blog-single-element.ast-taxonomy-container a {
   
    pointer-events: none;
}
.ast-blog-single-element {
	display: flex !important;
}

.table.dataTable thead .sorting {
	background: none !important;
}
.cisce-box-custom {
    position: relative;
}
.cisce-box-footer {
    position: absolute;
    bottom: 0;
}
.entry-content h4 {
    margin: 0 !important;
}
.entry-content p {
	margin-bottom: 0px !important;
}

/* About Us */
.about-us-timeline .stratum-vertical-timeline-item .stratum-vertical-timeline-item__point-content {
  background-color: #e8e8f6;
	background-image: linear-gradient(to bottom right, #2563eb, #475569);
}
.about-us-timeline .stratum-vertical-timeline__line-progress {
  background-color: #1E293B;
	background-image: linear-gradient(to bottom right, #2563eb, #475569);
}
.blue-num-title {
	  min-width: 24px;
    width: 24px;
    height: 24px;
}

/* Gallery */
.gallery-items-container .gallery-single-item figure.fg-item-inner {
    border: 0;
}
.gallery-items-container .gallery-single-item .fg-caption-title {
    padding: 16px;
    margin: 0;
    background-color: #ffffff;
    color: #1e293b;
    font-size: 18px;
    font-weight: 500;
    line-height: 1.3em;
}
.gallery-items-container .foogallery .fg-image-overlay {
    background-color: rgb(4 92 180 / 50%);
}
.gallery-items-container .gallery-single-item img.fg-image {
    width: 100%;
    object-fit: cover;
}
.gallery-items-container .gallery-single-item .foogallery .fg-image-overlay:before {
    width: 24px;
    height: 24px;
	
    background-size: 24px 24px;
    min-width: 24px;
    min-height: 24px;
}

/* Header */
